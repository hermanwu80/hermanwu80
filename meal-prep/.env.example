# Needed for AI-written recipes. Without it the app runs in demo mode with a small built-in recipe library.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5-5. Faster/cheaper: claude-sonnet-5-5 or claude-haiku-4-5
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: require this password before anyone can use the app (recommended once it's reachable from the internet,
# because every "get ideas" tap spends API credit).
# APP_PASSWORD=

# Where the SQLite database lives (mount a persistent disk here when hosting).
# DATA_DIR=./data
# PORT=3000
# Set to 1 only if you serve over plain http beyond localhost.
# INSECURE_COOKIES=1
