# Required for receipt scanning, email reading and "Ask your budget".
# Without it the app still works for manual entry.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5-5. Cheaper options: claude-sonnet-5-5, claude-haiku-4-5
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Where the SQLite database and receipt images live (mount a persistent disk here).
# DATA_DIR=./data
# PORT=3000

# Set to 1 only if you serve over plain http (e.g. testing on your home network).
# INSECURE_COOKIES=1
